{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "theme": "Shared.Common.SerilogTheme::Custom, Shared.Common"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Firefall": {
    "PublicHost": "localhost",
    "AdvertiseHttps": true,
    "MatrixPort": 25000,
    "Certificate": {
      "Path": "",
      "Password": ""
    },
    "GameServerApi": {
      "Port": 5201,
      "CharacterStorePath": ""
    },
    "Accounts": {
      "AccountStorePath": ""
    },
    "WebHosts": {
      "WebHost.OperatorApi": {
        "urls": "https://*:44300;http://*:4400"
      },
      "WebHost.WebAsset": {
        "urls": "https://*:44301;http://*:4401"
      },
      "WebHost.ClientApi": {
        "urls": "https://*:44302;http://*:4402"
      },
      "WebHost.InGameApi": {
        "urls": "https://*:44303;http://*:4403"
      },
      "WebHost.WebAccount": {
        "urls": "https://*:44304;http://*:4404"
      },
      "WebHost.Frontend": {
        "urls": "https://*:44305;http://*:4405"
      },
      "WebHost.Store": {
