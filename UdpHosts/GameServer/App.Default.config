<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- Firefall installation paths (StaticDBPath, MapsPath, AssetDBPath, CachePath) are configured in GameServer.config.json -->
    <appSettings>
        <add key="serilog:minimum-level" value="Debug"/>
        <add key="serilog:write-to" value="Console"/>
        <add key="Port" value="25001"/>
        <add key="ClientVersion" value="1962"/>
        <add key="ClientEnvironment" value="production"/>
        <add key="ClientBranch" value="prod"/>
        <add key="GrpcChannelAddress" value="http://localhost:5201"/>
        <add key="ZoneId" value="448"/>
        <add key="LoadMapsCollision" value="true"/>
        <add key="LoadZoneEntities" value="true"/>
        <!-- Threads the server's own background work may use. 0 = automatic: one thread per
             processor minus the shard's own core, capped at eight. A number you write here is used
             as given, so a 16-thread machine can be told to run past the automatic eight - that is
             what the per-piece keys below are for. See Docs/MULTITHREADING.md for what is threaded
             (the navigation-mesh bake and the world-population plan build) and what deliberately
             stays on the shard's single thread. -->
        <add key="ServerWorkerThreads" value="0"/>

        <!-- Navigation-mesh bake threads, 0 = follow ServerWorkerThreads. This is the long step of
             loading a zone, and it runs before the shard accepts a client, so it is the one piece of
             work that may be given almost every core:
                 8 CPU  (4C/8T):  7   - all of them but the shard's own
                16 CPU  (8C/16T): 14  - leave the shard and one core of slack; 15 if nothing else
                                        runs on the box, 8-10 if you launch the game client during
                                        the load (the client's own startup is CPU-hungry) -->
        <add key="NavigationBakeThreads" value="0"/>

        <!-- World-population plan build threads, 0 = follow ServerWorkerThreads. Unlike the bake this
             runs while players are in the zone, next to the shard's tick, the physics dispatcher and
             (on a shared machine) the game client, so it wants fewer threads:
                 8 CPU  (4C/8T):  4-6
                16 CPU  (8C/16T): 8-10, or 6-8 if the game client runs on the same machine -->
        <add key="WorldPopulationPlanThreads" value="0"/>

        <!-- Bepu physics dispatcher threads. 0 = the engine's own choice: one thread per processor
             minus two, capped at four (a 20 Hz shard with mostly static zone geometry does not need
             more, and every dispatch thread spins when idle). Raise it only for a zone with many
             moving bodies:
                 8 CPU  (4C/8T):  4   - the cap, and enough
                16 CPU  (8C/16T): 4-6 - 5-6 only if fights with lots of moving NPCs matter more than
                                        the CPU they take from the client -->
        <add key="PhysicsThreads" value="0"/>

        <!-- Build the population plan on those worker threads instead of one budgeted slice per
             shard tick. Same plan either way; on workers it is ready in about the time its CPU work
             takes instead of tens of seconds of tick budgets. Set false to keep the plan on the
             shard's tick (which then ignores WorldPopulationPlanThreads). -->
        <add key="WorldPopulationPlanOnWorkers" value="true"/>
        <!-- World population: every value used by the planner, streaming service, and placement code
             is configurable here. See Docs/WORLD_POPULATION.md for descriptions and tuning guidance.
             Settings use invariant-culture numbers (a period, not a comma, for decimals). -->
        <add key="SpawnWorldPopulation" value="true"/>
        <!-- When true, spawns the full population across the entire zone instead of distance-based
             streaming around players, and keeps all NPCs spawned without despawning. -->
        <add key="WorldPopulationSpawnFullZone" value="false"/>
        <!-- Conservative density and streaming defaults leave CPU/network headroom for combat. -->
        <add key="WorldPopulationMaxLiveNpcs" value="150"/>
        <add key="WorldPopulationActivationRadius" value="150"/>
        <add key="WorldPopulationDeactivationRadius" value="225"/>
        <add key="WorldPopulationCellSize" value="32"/>
        <add key="WorldPopulationMaxNpcsPerCell" value="4"/>
        <add key="WorldPopulationMaxDifficultyPerCell" value="400"/>
        <add key="WorldPopulationUnbudgetedDifficultyCost" value="25"/>
        <add key="WorldPopulationMaxPlannedSlots" value="20000"/>
        <!-- Four spawns per 100 ms limits a fresh area's population burst to 40 NPCs per second. -->
        <add key="WorldPopulationSpawnBudget" value="4"/>
        <add key="WorldPopulationSpawnBudgetWindowMs" value="100"/>
        <add key="WorldPopulationTickIntervalMs" value="250"/>
        <add key="WorldPopulationPlanWorkPerTick" value="20000"/>
        <add key="WorldPopulationMinSeparation" value="0.5"/>
        <add key="WorldPopulationMinPlayerDistance" value="25"/>
        <add key="WorldPopulationMaxPlacementAttempts" value="6"/>
        <!-- Placement attempts one update may spend. An attempt that reaches the ground costs
             ~15 physics queries, so this is what keeps one update bounded while the plan fills
             over several updates instead of stalling the shard. -->
        <add key="WorldPopulationPlacementAttemptsPerUpdate" value="200"/>
        <add key="WorldPopulationPlacementRetryDelayMs" value="1000"/>
        <add key="WorldPopulationMaxPlacementFailures" value="8"/>
        <add key="WorldPopulationRespawnDelayMs" value="30000"/>
        <add key="WorldPopulationMinimumWalkableNormalZ" value="0.35"/>
        <add key="WorldPopulationDefaultBodyRadius" value="0.7"/>
        <add key="WorldPopulationDefaultBodyHeight" value="1.8"/>
        <add key="WorldPopulationDeployableInfluenceRadius" value="25"/>
        <!-- Authored outpost radius is the capture circle (150-550 m); this is the inhabited camp. -->
        <add key="WorldPopulationOutpostSettlementRadius" value="80"/>
        <add key="WorldPopulationMeldingInfluenceRadius" value="120"/>
        <add key="ForceReloadZone" value="false"/>
        <add key="BatchOutgoingPackets" value="true"/>
    </appSettings>
</configuration>