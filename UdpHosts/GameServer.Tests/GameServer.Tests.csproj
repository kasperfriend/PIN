<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
    <PackageReference Include="xunit" Version="2.9.2"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameServer\GameServer.csproj"/>
    <!-- Direct reference for the Shared.Common account/character store tests
         (project references are transitive, but the tests use these types
         explicitly and should not depend on GameServer pulling them in). -->
    <ProjectReference Include="..\..\Lib\Shared.Common\Shared.Common.csproj"/>
    <!-- The advertised addresses and the certificate behind them are shared web-host
         configuration (PublicUrls, TlsCertificateStore); the rules of both are worth
         testing whether or not a web host is running, so they are tested here. -->
    <ProjectReference Include="..\..\Lib\Shared.Web\Shared.Web.csproj"/>
  </ItemGroup>
</Project>
